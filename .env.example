# CareVoice Backend Environment Variables (Example - Replace with real values in hosting dashboard)
# Never commit real secrets, .env files, or production credentials to Git.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL connection string (automatically injected by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# JWT Authentication (use a strong 32+ character random secret)
JwtSettings__Secret=REPLACE_WITH_STRONG_32_PLUS_CHARACTER_RANDOM_SECRET
JwtSettings__Issuer=CareVoiceApi
JwtSettings__Audience=CareVoiceClient
JwtSettings__AccessTokenExpiryMinutes=60

# Private Cloud Object Storage (Amazon S3 or S3-compatible private bucket)
ObjectStorage__Provider=AmazonS3
S3_BUCKET_NAME=your-private-carevoice-documents-bucket
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
AWS_REGION=us-east-1
# Optional for S3-compatible providers (e.g. Cloudflare R2, Backblaze B2, MinIO)
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# Email OTP Delivery (Optional Gmail SMTP)
EmailSettings__SenderEmail=your-sender@example.com
EmailSettings__SenderName=CareVoice Medicine Reminder
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__EnableSsl=true
EmailSettings__Username=your-sender@example.com
EmailSettings__Password=REPLACE_WITH_SMTP_APP_PASSWORD

# Optional Speech/AI Providers
SarvamAi__ApiKey=
SerbomAi__ApiKey=
