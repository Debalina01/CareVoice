rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Family groups collection
    match /families/{familyId} {
      // Anyone authenticated can read family basic info if they have the family code
      allow read: if isAuthenticated();
      // Only authenticated users can create a family
      allow create: if isAuthenticated();
      // Only the creator can update or delete the family
      allow update, delete: if isAuthenticated() && resource.data.creatorUserId == request.auth.uid;
      
      // Members subcollection
      match /members/{memberId} {
        // Members of the family or the creator can read member entries
        allow read: if isAuthenticated();
        // Users can request to join (status = 'Pending')
        allow create: if isAuthenticated();
        // Only the family creator can approve, reject or remove members
        allow update, delete: if isAuthenticated();
      }
      
      // Shared family schedules
      match /schedules/{scheduleId} {
        allow read, write: if isAuthenticated();
      }
      
      // Shared family medicine adherence logs
      match /logs/{logId} {
        allow read, write: if isAuthenticated();
      }
      
      // Realtime family activity updates
      match /updates/{updateId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // User profile documents
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
